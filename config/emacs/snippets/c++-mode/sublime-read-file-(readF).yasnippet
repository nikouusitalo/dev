# -*- mode: snippet -*-
# name: Sublime: Read File Into Vector
# key: readfile
# group: Sublime
# uuid: sublime-C++-read-file-(readF)
# --
std::vector<char> v;
if (FILE *fp = fopen(${1:"filename"}, "r"))
{
	char buf[1024];
	while (size_t len = fread(buf, 1, sizeof(buf), fp))
		v.insert(v.end(), buf, buf + len);
	fclose(fp);
}
